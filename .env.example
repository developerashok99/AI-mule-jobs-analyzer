# Groq API key (https://console.groq.com/keys) - free-tier, used for question generation and JD/company analysis
GROQ_API_KEY=

# Telegram bot for this project (create a NEW bot via @BotFather, separate from any other bot you run)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: raises GitHub API rate limit when pulling lecture notes from the Notes repo
GITHUB_TOKEN=

# Source repo containing your MuleSoft lecture notes
NOTES_REPO=Ashokkumarkarri/Notes
NOTES_PATH=Mulesoft/Study Notes
